program ifTest {
	clock 100;
	node MainNode { clock 100; }
	int8 var1 as (read = inp, bit = 1);
	bool var2 as (read = inp, bit = 2);
	
	process Init :: node MainNode {
		state begin {
			switch (var1){
				case 0 :{var1 = 0;}
				case 1 :{var2 = false;break;}
				case 2 :{var1 = 2;}
				default :{var2 = true;}
			}		}
	}
	
}
